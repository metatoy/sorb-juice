# ---------------------------------------------------------------------------
# @sorb/juice — environment configuration (read by src/config.js via loadConfig).
#
# Copy to `.env` and adjust. EVERY value below has a safe local default, so the
# FREE local bridge runs with this file entirely blank/absent:
#   - leave REDIS_URL + DATABASE_URL UNSET -> in-memory store, no Postgres
#     (today's single-process Map + TTL behavior).
# Set the hosted backends only when running the docker-compose / hosted stack.
# ---------------------------------------------------------------------------

# HTTP listen port for the bridge server.
# Default: 7777
PORT=7777

# Tenant/app namespace surfaced in /health and config.namespace.
# Overridden by sorb.config.json `namespace` in local mode.
# Default: sorb-local
SORB_NAMESPACE=sorb-local

# redis:// connection string. PRESENCE is the switch: when set, the store
# dynamically imports redis.js; when UNSET the in-memory store is used.
# Default: (unset -> in-memory store)
# REDIS_URL=redis://localhost:6379

# postgres:// connection string. PRESENCE is the switch: when set, the db layer
# dynamically imports pg and opens a Pool; when UNSET createDb returns null.
# Default: (unset -> no Postgres, local mode)
# DATABASE_URL=postgres://sorb:sorb@localhost:5432/sorb

# Comma-separated allowed origins for Hono CORS.
# Empty/unset -> '*' (open, free local default). config.js parses to an array.
# Default: * (open)
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# TTL for previews AND verifications, in milliseconds.
# Drives the memory prune window and Redis PX. Default preserves 24h.
# Default: 86400000
PREVIEW_TTL_MS=86400000

# How often the in-memory store prunes expired entries, in milliseconds.
# Default preserves the hourly prune.
# Default: 3600000
PRUNE_INTERVAL_MS=3600000

# Standard env marker (development|production); informs logging/error verbosity.
# Non-load-bearing for backend selection.
# Default: development
NODE_ENV=development

# --- Sentry (optional; hosted `serve` path only) ---------------------------
# Error reporting for the hosted bridge. PRESENCE is the switch: when SENTRY_DSN
# is set, the `serve` command initializes @sentry/node and reports server-side
# DB-error/bookkeeping catches; when UNSET, Sentry is a complete NO-OP (no init,
# no network, no client). The free local `sorb dev` never initializes Sentry.
# Default: (unset -> Sentry off)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Sentry environment label; falls back to NODE_ENV, then 'production'.
# Default: (unset -> NODE_ENV || production)
# SENTRY_ENVIRONMENT=production
